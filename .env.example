# Vite 환경변수 템플릿 — 실제 값은 .env.local (gitignored) 에 작성하세요.
#
# 우선순위 (높은 순):
#   .env.local                  ← 개인 로컬 오버라이드 (gitignored)
#   .env.[mode].local           ← gitignored, mode별 개인값
#   .env.[mode]                 ← .env.development / .env.production (git 트래킹)
#   .env                        ← 사용 안 함 (gitignored, 환경별 분리됨)
#
# mode: `vite dev` = development, `vite build` = production

# === VITE_BACKEND_URL ===
# 백엔드 API base URL. 빈 값이면 axios가 relative URL 사용 → vite proxy 또는 nginx 프록시 경유.
#
# 로컬 개발(.env.local):     http://localhost:7001    # 로컬 백엔드 직접 호출
# 운영 빌드(.env.production):                          # 빈 값 → nginx /api → 백엔드 프록시
# 또는 EC2 백엔드로 직접:    https://api.show-gy.com
VITE_BACKEND_URL=
